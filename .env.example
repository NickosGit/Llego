# Copia este archivo a .env.local y rellena los valores. NUNCA subas .env.local.

# Públicas (llegan al navegador). En Vercel: Settings -> Environment Variables.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Secreta. Solo la usan los scripts de scripts/ (modelo por lotes y pruebas RLS).
# No la pongas en Vercel: la app no la necesita.
SUPABASE_SERVICE_ROLE_KEY=
